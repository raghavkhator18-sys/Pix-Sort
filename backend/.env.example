# Google Cloud & Google Drive API Configuration for PixSort

# OAuth 2.0 Credentials (Required for private folders and explicit user authorization)
# Create credentials in Google Cloud Console: APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized redirect URIs: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# (Optional) Google API Key (For accessing publicly shared links without requiring user login)
# Enable Google Drive API in Google Cloud Console: APIs & Services -> Enable APIs and Services -> Google Drive API
GOOGLE_API_KEY=

